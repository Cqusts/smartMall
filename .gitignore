# ---- 密钥与环境（绝不提交）----
deploy/.env
.env
.env.local
*.pem
*.key

# ---- Java ----
target/
*.jar
*.class
# .mvn/ 下只有 wrapper 配置需要提交，其余（jvm.config、IDE 生成物）不要。
#
# 不能写成 `.mvn/` 加一行 `!.mvn/wrapper/xxx` —— **父目录被排除时，git 不会
# 再去看目录里的取消排除规则**，那行否定形同虚设。必须一层层放行：
# 先只排除 .mvn 下的条目（而非目录本身），放行 wrapper 目录，再排除它里面的
# 条目，最后放行那个文件。
#
# 这条真踩过：wrapper 生成后 mvnw / mvnw.cmd 能进版本库，
# maven-wrapper.properties 却被悄悄挡住 —— 别人拉下来是一个跑不起来的 wrapper。
.mvn/*
!.mvn/wrapper
.mvn/wrapper/*
!.mvn/wrapper/maven-wrapper.properties

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# ---- 前端 ----
node_modules/
apps/web/dist/
.vite/

# ---- 模型与数据（体积大，用 download-models.sh 获取）----
/data/
models/
*.safetensors
*.ckpt
*.pth
*.bin
datasets/raw/
datasets/*.jsonl

# ---- 运行产物 ----
logs/
*.log
airflow.db
comfyui-output/
# 运营 Agent 生成的图与视频。**不进版本库**：一个 5 秒 720P 视频就是几 MB，
# 而且它是可再生的——库里的 prompt 与 model 留着，重跑一次就有
apps/python/ai-agent/web/generated/

# ---- IDE ----
.idea/
.vscode/
*.iml
.DS_Store

# ---- Milvus Lite ----
# 嵌入式模式下 collection 是一个**目录**（3.x 起，不是单文件），
# 默认落在 ./data/kb.db。索引是派生数据，重跑 `index` 就能重建。
data/
*.db/
